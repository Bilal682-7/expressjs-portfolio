<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Portfolio of Mohammad Bilal Sikandar, a Networking and IT Security student at Ontario Tech University.">
  <title><%= title %> | Mohammad Bilal Sikandar</title>

  <!-- Bootstrap 5 CSS from CDN (https://getbootstrap.com) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome icons from CDN (https://fontawesome.com) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <!-- My own colours and tweaks -->
  <link rel="stylesheet" href="/stylesheets/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">

  <!-- Shared navbar: appears on every page because every page includes this partial -->
  <header>
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar" aria-label="Main navigation">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">
          <i class="fa-solid fa-shield-halved me-2"></i>Mohammad Bilal Sikandar
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto">
            <!-- 'active' is sent from the route so the current page is highlighted -->
            <li class="nav-item"><a class="nav-link <%= active === 'home' ? 'active' : '' %>" href="/"><i class="fa-solid fa-house me-1"></i>Home</a></li>
            <li class="nav-item"><a class="nav-link <%= active === 'about' ? 'active' : '' %>" href="/about"><i class="fa-solid fa-user me-1"></i>About Me</a></li>
            <li class="nav-item"><a class="nav-link <%= active === 'projects' ? 'active' : '' %>" href="/projects"><i class="fa-solid fa-diagram-project me-1"></i>Projects</a></li>
            <li class="nav-item"><a class="nav-link <%= active === 'contact' ? 'active' : '' %>" href="/contact"><i class="fa-solid fa-envelope me-1"></i>Contact</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <main class="flex-grow-1">